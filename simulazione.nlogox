<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[extensions [py]

; -----------------------------------------------------
; 1. GLOBALS
; -----------------------------------------------------
patches-own [
  walkable?   ; Booleano (true/false) per i muri, i tavoli e il bancone
  zona        ; Stringa per identificare il tipo di POI (es: "bagno", "cassa")
  
  ; Variabili per i "profumi"
  dist-cassa
  dist-drink
  dist-birra
  dist-giochi
  dist-bagno
]

turtles-own [
  timer-attesa      ; Contatore per i tick da aspettare
  stato             ; Stringa: ricorda l'azione corrente
  drink-consumati   ; Conta drink consumati da ognuno
  ultimo-pensiero
  memoria
  
  ;; --- VARIABILI OCEAN ---
  is-ocean?   ;; Booleano: true per i 10 agenti speciali, false per gli altri
  trait-O     ;; Openness (0.0 - 1.0)
  trait-C     ;; Conscientiousness (0.0 - 1.0)
  trait-E     ;; Extraversion (0.0 - 1.0)
  trait-A     ;; Agreeableness (0.0 - 1.0)
  trait-N     ;; Neuroticism (0.0 - 1.0)
]

; -----------------------------------------------------
; 2. SETUP
; -----------------------------------------------------
to setup
  clear-all  ; Pulisce il mondo da simulazioni precedenti

  ; Importa la mappa e colora i patches
  import-pcolors "map.png" 

  ; Inizializzazione della mappa
  ask patches [
    ; Impostazioni di default per i pavimenti bianchi/spazi vuoti
    set walkable? true
    set zona "passaggio" 

    ; MAPPATURA DEI COLORI E DEI PUNTI DI INTERESSE (POI)
    ; 1. Arancione: Entrata/Uscita
    if pcolor = 24.9 [ 
      set zona "entrata-uscita" 
    ]
    
    ; 2. Lime: Cestini (Non calpestabili)
    if pcolor = 64.9 [ 
      set walkable? false 
      set zona "cestino" 
    ]
    
    ; 3. Blu: Tavoli (Non calpestabili)
    if pcolor = 104.9 [ 
      set walkable? false 
      set zona "tavolo" 
    ]
    
    ; 4. Magenta: Giochi
    if pcolor = 125.5 [ 
      set zona "giochi" 
    ]
    
    ; 5. Rosa: Karaoke
    if pcolor = 126.1 [ 
      set zona "karaoke" 
    ]
    
    ; 6. Rosso: Cassa (Non calpestabile)
    if pcolor = 14.9 [ 
      set walkable? false 
      set zona "cassa" 
    ]
    
    ; 7. Giallo: Ritiro Birra (Non calpestabile)
    if pcolor = 45 [ 
      set walkable? false 
      set zona "ritiro-birra" 
    ]
    
    ; 8. Verde: Ritiro Drink (Non calpestabile)
    if pcolor = 54.9 [ 
      set walkable? false 
      set zona "ritiro-drink" 
    ]
    
    ; 9. Marrone: Bagno
    if pcolor = 34.9 [ 
      set zona "bagno" 
    ]
    
    ; 10. Grigio: Bancone (Non calpestabile)
    if pcolor = 4.9 [ 
      set walkable? false 
      set zona "bancone" 
    ]
    
    ; 11. Nero: Muri e zone inaccessibili (Non calpestabile)
    if pcolor = 0 [ 
      set walkable? false 
      set zona "muro" 
    ]
    
    ; 12. Turchese: Vetri (Non calpestabile)
    if pcolor = 85.8 [
      set walkable? false
      set zona "vetro"
    ]
    
  ]
  
  calcola-percorsi
  
    ; Avvia l'ambiente Python 
  py:setup py:python 

  ; Definiamo entrambe le funzioni Python: genera_pensiero e chiedi_a_ollama
  py:run (word
    "import urllib.request\n"
    "import json\n"
    
    ; --- genera_pensiero ---
    "def genera_pensiero(profilo, ricordi, evento):\n"
    "    url = 'http://localhost:11434/api/generate'\n"
    "    prompt = f'Sei un ragazzo/a in un bar. Tratti OCEAN: {profilo}. I tuoi ricordi: {ricordi}. Ora sta succedendo questo: {evento}. Formula un breve pensiero interiore (max 15 parole) coerente con la tua personalità e i tuoi ricordi.'\n"
    "    data = {'model': 'gemma3:4b', 'prompt': prompt, 'stream': False}\n"
    "    req = urllib.request.Request(url, data=json.dumps(data).encode('utf-8'), headers={'Content-Type': 'application/json'})\n"
    "    try:\n"
    "        with urllib.request.urlopen(req) as res:\n"
    "            return json.loads(res.read().decode('utf-8'))['response'].strip()\n"
    "    except Exception as e:\n"
    "        return f'ERRORE: {str(e)}'\n"
    "\n"
    
    ; --- chiedi_a_ollama ---
    "def chiedi_a_ollama(profilo, contesto):\n"
    "    url = 'http://localhost:11434/api/generate'\n"
    "    prompt = f'Sei un ragazzo/a in un bar. Il tuo carattere OCEAN (da 0 a 1) è: {profilo}. {contesto} REGOLE TASSATIVE: 1) Parla in prima persona. 2) Usa un linguaggio giovanile, super informale, molto diretto. 3) È ASSOLUTAMENTE VIETATO usare frasi fatte, scuse, eccessiva cortesia o dire cose come \"che piacere\", \"sono felice\", \"sorriso\". 4) Massimo 12 parole. 5) Vai dritto al punto.'\n"
    "    data = {'model': 'gemma3:4b', 'prompt': prompt, 'stream': False}\n"
    "    req = urllib.request.Request(url, data=json.dumps(data).encode('utf-8'), headers={'Content-Type': 'application/json'})\n"
    "    try:\n"
    "        with urllib.request.urlopen(req) as res:\n"
    "            return json.loads(res.read().decode('utf-8'))['response'].strip()\n"
    "    except Exception as e:\n"
    "        return f'ERRORE: {str(e)}'\n"
  )

  ; SPAWN TURTLES
  ;; 1. CREAZIONE DEI XX AGENTI STANDARD
  create-turtles 20 [
    set color cyan
    set shape "person" 
    set size 3
    set timer-attesa 0
    set drink-consumati 0
    
    set is-ocean? false ;; Agente standard
    
    move-to one-of patches with [zona = "entrata-uscita"]
    scegli-nuovo-obiettivo
  ]

  ;; 2. CREAZIONE DEI 10 AGENTI OCEAN
  create-turtles 10 [
    set color red  ;; Li coloriamo di rosso per riconoscerli
    set shape "person"
    set size 3
    set timer-attesa 0
    set drink-consumati 0
    
    set is-ocean? true ;; Agente intelligente
    
    ;; Assegniamo valori psicologici casuali tra 0 e 1
    ;; (In futuro potrai decidere di creare profili specifici, es. "il festaiolo")
    set trait-O random-float 1.0
    set trait-C random-float 1.0
    set trait-E random-float 1.0
    set trait-A random-float 1.0
    set trait-N random-float 1.0
    
    set memoria "Sono appena arrivato nel locale."

    move-to one-of patches with [zona = "entrata-uscita"]
    scegli-nuovo-obiettivo
  ]

  reset-ticks  ; Azzera il contatore del tempo (i "ticks")
end

; -----------------------------------------------------
; 3. GO
; -----------------------------------------------------
to go
  ask turtles [
    
    ; -----------------------------------------------------
    ; 1. GESTIONE DEI TIMER E CAMBIO DI STATO
    ; -----------------------------------------------------
    if timer-attesa > 0 [
      set timer-attesa timer-attesa - 1
      
      if timer-attesa = 0 [
        
        let stato-finito stato 
        
        if stato-finito = "acquisto-cassa" [
          ifelse random 100 < 60 [ set stato "verso-drink" ] [ set stato "verso-birra" ]
          set label stato
        ] 
        
        if stato-finito = "attesa-drink" or stato-finito = "attesa-birra" [
          set drink-consumati drink-consumati + 1
          let va-in-bagno? false
          
          if drink-consumati = 1 and random 100 < 50 [ set va-in-bagno? true ]
          if drink-consumati = 2 and random 100 < 75 [ set va-in-bagno? true ]
          if drink-consumati >= 3 [ set va-in-bagno? true ]
          
          ifelse va-in-bagno? [ set stato "verso-bagno" set label stato rifletti "Ho bevuto troppo, devo scappare in bagno!" ] 
                              [ scegli-nuovo-obiettivo ]
        ]
        
        if stato-finito = "bagno" [
          set drink-consumati 0
          scegli-nuovo-obiettivo
        ]
        
        if stato-finito != "acquisto-cassa" and stato-finito != "attesa-drink" and stato-finito != "attesa-birra" and stato-finito != "bagno" [
          scegli-nuovo-obiettivo
        ]
      ]
      
      ; MODIFICA: Ferma chi deve aspettare, MA fa camminare chi esplora o chi cerca amici!
      if timer-attesa > 0 and stato != "esplora" and stato != "cerca-amico" [ stop ]
    ]

    ; -----------------------------------------------------
    ; 2. MOVIMENTO, INCONTRI E CODE
    ; -----------------------------------------------------
    
    ; Esploratori e Cercatori di amici si muovono per il locale
    if stato = "esplora" or stato = "cerca-amico" [
      right random 60 - 30
      let prossima-patch patch-ahead 1
      ifelse prossima-patch != nobody 
         and [walkable?] of prossima-patch = true 
         and [zona] of prossima-patch != "bagno" 
         and not any? turtles-on prossima-patch [
        forward 1
      ] [ right random 180 ]
    ]
    
    ; LOGICA DI INCONTRO: "Se sto cercando un amico, mi guardo intorno ad ogni passo"
    if stato = "cerca-amico" [
      let amici other turtles in-radius 1.5 with [stato = "esplora" or stato = "cerca-amico"]
      
      if any? amici [
        let amico one-of amici
        
        set stato "chiacchiera"
        set timer-attesa 150 + random 50 ; Timer base
        face amico
        
        ; Memorizziamo i tipi di agenti
        let iniziatore-ocean? is-ocean?
        let amico-ocean? [is-ocean?] of amico
        
        ; Fermo l'amico
        ask amico [
          set stato "chiacchiera"
          set timer-attesa [timer-attesa] of myself
          face myself
        ]
        
        ; --- AVVIAMO IL DIALOGO SOLO SE ALMENO UNO È INTELLIGENTE ---
        if (iniziatore-ocean? = true) or (amico-ocean? = true) [
          print "--- INIZIO DIALOGO ---"
          
          ; =====================================================
          ; CASO 1: INTELLIGENTE vs INTELLIGENTE (5-15 battute)
          ; =====================================================
          if iniziatore-ocean? = true and amico-ocean? = true [
            let num-battute 5 + random 11 ; Sceglie un numero tra 5 e 15
            
            ; Aumentiamo il timer visivo in base a quanto parlano
            set timer-attesa (num-battute * 30)
            ask amico [ set timer-attesa [timer-attesa] of myself ]
            
            ; Prepariamo profili e MEMORIE
            let prof-iniz (word "O:" precision trait-O 1 " C:" precision trait-C 1 " E:" precision trait-E 1 " A:" precision trait-A 1 " N:" precision trait-N 1)
            let mem-iniz memoria
            
            let prof-amico (word "O:" precision [trait-O] of amico 1 " C:" precision [trait-C] of amico 1 " E:" precision [trait-E] of amico 1 " A:" precision [trait-A] of amico 1 " N:" precision [trait-N] of amico 1)
            let mem-amico [memoria] of amico
            
            ; -- Battuta 1 (Iniziatore) --
            py:set "profilo_py" prof-iniz
            ; Aggiungiamo la memoria al contesto della prima battuta
            py:set "contesto_py" (word "Incontri un amico. I tuoi ricordi recenti: " mem-iniz ". Inizia tu a parlare: commenta il tuo ricordo in modo molto colloquiale e buttala lì.")
            
            let ultima-frase py:runresult "chiedi_a_ollama(profilo_py, contesto_py)"
            set label ultima-frase set label-color black
            print (word "Agente " who " (Intelligente): " ultima-frase)
            
            ; -- Ciclo botta e risposta --
            let contatore 1
            repeat (num-battute - 1) [
              set contatore contatore + 1
              
              ifelse contatore mod 2 = 0 [
                ; Turno Pari: tocca all'Amico
                py:set "profilo_py" prof-amico
                ; Inseriamo la memoria dell'amico nella sua risposta
                py:set "contesto_py" (word "Un amico ti ha appena detto: '" ultima-frase "'. I tuoi ricordi recenti: " mem-amico ". Rispondi agganciandoti alla sua frase in modo secco, usando il tuo ricordo come argomento.")
                
                set ultima-frase py:runresult "chiedi_a_ollama(profilo_py, contesto_py)"
                ask amico [ set label ultima-frase set label-color black ]
                print (word "Agente " [who] of amico " (Intelligente): " ultima-frase)
              ] [
                ; Turno Dispari: tocca all'Iniziatore
                py:set "profilo_py" prof-iniz
                ; Inseriamo la memoria dell'iniziatore
                py:set "contesto_py" (word "L'amico ti ha appena detto: '" ultima-frase "'. I tuoi ricordi: " mem-iniz ". Ribatti in modo informale e spontaneo, senza troppi giri di parole.")
                
                set ultima-frase py:runresult "chiedi_a_ollama(profilo_py, contesto_py)"
                set label ultima-frase set label-color black
                print (word "Agente " who " (Intelligente): " ultima-frase)
              ]
            ]
          ]
          
          ; =====================================================
          ; CASO 2: INTELLIGENTE vs STANDARD (3 fasi)
          ; =====================================================
          if iniziatore-ocean? = true and amico-ocean? = false [
            let prof-iniz (word "O:" precision trait-O 1 " C:" precision trait-C 1 " E:" precision trait-E 1 " A:" precision trait-A 1 " N:" precision trait-N 1)
            
            ; 1. Iniziatore
            py:set "profilo_py" prof-iniz
            py:set "contesto_py" "Hai appena incontrato un amico nel locale. Salutalo in base al tuo profilo."
            let msg1 py:runresult "chiedi_a_ollama(profilo_py, contesto_py)"
            set label msg1 set label-color black
            print (word "Agente " who " (Intelligente): " msg1)
            
            ; 2. Amico Standard
            let risposte-stupide ["Ah sì, figata!" "Io tutto bene, tu?" "Vero, c'è un sacco di gente!" "Dai, ci si becca in giro!"]
            let msg2 one-of risposte-stupide
            ask amico [ set label msg2 set label-color black ]
            print (word "Agente " [who] of amico " (Standard): " msg2)
            
            ; 3. Iniziatore chiude
            py:set "contesto_py" (word "L'amico ti ha appena risposto dicendo: '" msg2 "'. Fagli una breve battuta finale per concludere la chiacchierata.")
            let msg3 py:runresult "chiedi_a_ollama(profilo_py, contesto_py)"
            set label msg3
            print (word "Agente " who " (Intelligente): " msg3)
          ]
          
          ; =====================================================
          ; CASO 3: STANDARD vs INTELLIGENTE (2 fasi)
          ; =====================================================
          if iniziatore-ocean? = false and amico-ocean? = true [
            ; 1. Iniziatore Standard
            let risposte-stupide ["Ciao!" "Ehi! Come butta?" "Tutto bene?" "Che ressa stasera!" "Bella serata eh!"]
            let msg1 one-of risposte-stupide
            set label msg1 set label-color black
            print (word "Agente " who " (Standard): " msg1)
            
            ; 2. Amico Intelligente
            let prof-amico (word "O:" precision [trait-O] of amico 1 " C:" precision [trait-C] of amico 1 " E:" precision [trait-E] of amico 1 " A:" precision [trait-A] of amico 1 " N:" precision [trait-N] of amico 1)
            py:set "profilo_py" prof-amico
            py:set "contesto_py" (word "Un amico ti ha appena salutato dicendo: '" msg1 "'. Rispondi coerentemente con il tuo profilo.")
            let msg2 py:runresult "chiedi_a_ollama(profilo_py, contesto_py)"
            ask amico [ set label msg2 set label-color black ]
            print (word "Agente " [who] of amico " (Intelligente): " msg2)
          ]
          
          print "----------------------"
        ]
      ]
    ]

    
    ; --- IL RESTO DEI MOVIMENTI PER LE CODE ---
    if stato = "verso-cassa" or stato = "verso-giochi" or stato = "verso-drink" or stato = "verso-birra" or stato = "verso-bagno" [
      
      muovi-verso-destinazione 
      
      if stato = "verso-cassa" and [dist-cassa] of patch-here = 1 [
        if not any? turtles with [stato = "acquisto-cassa"] [
          set stato "acquisto-cassa" set label stato set timer-attesa 15
          rifletti "Sto ordinando e pagando alla cassa." 
        ]
      ]
      
      if stato = "verso-drink" and [dist-drink] of patch-here = 1 [
        if not any? turtles with [stato = "attesa-drink"] [
          set stato "attesa-drink" set label "attesa" set timer-attesa 40
          rifletti "Sono al bancone, aspetto che il barista mi prepari il drink."
        ]
      ]
      
      if stato = "verso-birra" and [dist-birra] of patch-here = 1 [
        if not any? turtles with [stato = "attesa-birra"] [
          set stato "attesa-birra" set label "attesa" set timer-attesa 30
          rifletti "Aspetto il mio turno per farmi spillare la birra."
        ]
      ]
      
      if stato = "verso-bagno" and [dist-bagno] of patch-here = 1 [
        if not any? turtles with [stato = "bagno"] [
          set stato "bagno" set label stato set timer-attesa 50
          move-to min-one-of (neighbors with [dist-bagno = 0]) [distance myself]
          rifletti "Finalmente sono in bagno."
        ]
      ]

      if stato = "verso-giochi" and [dist-giochi] of patch-here = 1 [
        set stato "gioca" set label stato set timer-attesa 100 + random 100
        rifletti "Che bello, inizio a giocare!"
      ]
    ]
  ]

  tick
end

to scegli-nuovo-obiettivo
  ifelse is-ocean? = false [
    ;; ----------------------------------------------------
    ;; COMPORTAMENTO STANDARD (190 agenti)
    ;; ----------------------------------------------------
    let decisione random 100
    if decisione < 30 [ set stato "verso-cassa" set timer-attesa 0 ]
    if decisione >= 30 and decisione < 60 [ set stato "verso-giochi" set timer-attesa 0 ]
    if decisione >= 60 and decisione < 80 [ set stato "cerca-amico" set timer-attesa 100 + random 150 ]
    if decisione >= 80 [ set stato "esplora" set timer-attesa 100 + random 150 ]
    
  ] [
    ;; ----------------------------------------------------
    ;; COMPORTAMENTO OCEAN (10 agenti)
    ;; ----------------------------------------------------
    ;; Calcoliamo il desiderio (peso) per ogni azione. Più è alto, più è probabile sceglierla.
    
    let peso-cassa 20 + (trait-N * 20) + (trait-C * 10)
    let peso-giochi 10 + (trait-O * 30) + (trait-E * 10)
    let peso-cerca-amico 10 + (trait-E * 50) + (trait-A * 10)
    
    ;; Il nevroticismo abbassa la voglia di esplorare senza meta
    let peso-esplora 10 + (trait-O * 40) - (trait-N * 20)
    if peso-esplora < 5 [ set peso-esplora 5 ] ;; Evitiamo pesi negativi
    
    ;; Sommiamo tutti i pesi
    let totale-pesi (peso-cassa + peso-giochi + peso-cerca-amico + peso-esplora)
    
    ;; Estraiamo un numero a caso sul totale (Roulette Wheel Selection)
    let dado random-float totale-pesi
    
    ;; Decidiamo l'obiettivo in base all'estrazione
    if dado < peso-cassa [
      set stato "verso-cassa" 
      set timer-attesa 0
      rifletti "Voglio andare alla cassa per prendere da bere." 
    ]
    if dado >= peso-cassa and dado < (peso-cassa + peso-giochi) [
      set stato "verso-giochi" 
      set timer-attesa 0
      rifletti "Mi è venuta voglia di giocare e divertirmi." 
    ]
    if dado >= (peso-cassa + peso-giochi) and dado < (peso-cassa + peso-giochi + peso-cerca-amico) [
      set stato "cerca-amico" 
      set timer-attesa 100 + random (150 + (trait-E * 100)) 
      rifletti "Ho voglia di socializzare, cerco qualche amico." 
    ]
    if dado >= (peso-cassa + peso-giochi + peso-cerca-amico) [
      set stato "esplora" 
      set timer-attesa 100 + random 150
      rifletti "Faccio un giro per esplorare il locale." 
    ]
  ]
  
  ;; Aggiorna la label visiva
  set label stato
  set label-color black
end

to muovi-verso-destinazione
  ; Cerca mattonelle libere da altre persone e ostacoli
  ; let vicini-liberi neighbors with [walkable? = true and not any? turtles-here]  
  let vicini-liberi neighbors with [walkable? = true and not any? turtles-here and dist-bagno > 0]
  
  ; Impedisce a chi passa per caso di calpestare il bagno
  ;if stato != "verso-bagno" and stato != "bagno" [
  ;  set vicini-liberi vicini-liberi with [dist-bagno > 0]
  ;]

  if any? vicini-liberi [
    let patch-migliore nobody
    let mia-distanza 9999
    
    ; 1. Valuta la distanza attuale dall'obiettivo
    if stato = "verso-cassa" [ set patch-migliore min-one-of vicini-liberi [dist-cassa] set mia-distanza dist-cassa ]
    if stato = "verso-drink" [ set patch-migliore min-one-of vicini-liberi [dist-drink] set mia-distanza dist-drink ]
    if stato = "verso-birra" [ set patch-migliore min-one-of vicini-liberi [dist-birra] set mia-distanza dist-birra ]
    if stato = "verso-giochi" [ set patch-migliore min-one-of vicini-liberi [dist-giochi] set mia-distanza dist-giochi ]
    if stato = "verso-bagno" [ set patch-migliore min-one-of vicini-liberi [dist-bagno] set mia-distanza dist-bagno ]
    
    if patch-migliore != nobody [
      let distanza-futura 9999
      if stato = "verso-cassa" [ set distanza-futura [dist-cassa] of patch-migliore ]
      if stato = "verso-drink" [ set distanza-futura [dist-drink] of patch-migliore ]
      if stato = "verso-birra" [ set distanza-futura [dist-birra] of patch-migliore ]
      if stato = "verso-giochi" [ set distanza-futura [dist-giochi] of patch-migliore ]
      if stato = "verso-bagno" [ set distanza-futura [dist-bagno] of patch-migliore ]

      ; 2. LOGICA SCORRIMENTO TRAFFICO E CODE
      ifelse distanza-futura < mia-distanza [
        ; Se la strada davanti è libera e mi avvicina, vado dritto deciso!
        face patch-migliore
        move-to patch-migliore
      ] [
        ; L'ostacolo davanti mi blocca la strada ottimale. 
        ; Distinguiamo chi è IN CODA da chi sta CERCANDO DI USCIRE o CAMMINARE.
        ifelse mia-distanza <= 3 [
          ; SONO IN CODA (vicino all'obiettivo): Sto fermo per non rompere la fila. 
          ; Mi sposto solo rarissimamente (5% dei casi) per sbloccare micro-ingorghi.
          if random 100 < 5 [ face patch-migliore move-to patch-migliore ]
        ] [
          ; STO CERCANDO DI USCIRE (lontano dall'obiettivo): 
          ; Sgomito aggirando l'ostacolo lateralmente per liberare il passaggio (80% dei casi).
          if random 100 < 80 [ face patch-migliore move-to patch-migliore ]
        ]
      ]
    ]
  ]
end

to calcola-percorsi
  ; 1. Inizializza tutto con una distanza altissima (irraggiungibile)
  ask patches [
    set dist-cassa 9999
    set dist-drink 9999
    set dist-birra 9999
    set dist-giochi 9999
    set dist-bagno 9999
  ]
  
  ; 2. Imposta a 0 la distanza esatta sui Punti di Interesse
  ask patches with [zona = "cassa"] [ set dist-cassa 0 ]
  ask patches with [zona = "ritiro-drink"] [ set dist-drink 0 ]
  ask patches with [zona = "ritiro-birra"] [ set dist-birra 0 ]
  ask patches with [zona = "giochi"] [ set dist-giochi 0 ]
  ask patches with [zona = "bagno"] [ set dist-bagno 0 ]
  
  ; 3. Diffusione del profumo su tutta la mappa camminabile!
  ; Ripetiamo il calcolo abbastanza volte da coprire tutta l'area
  let dimensione-mappa (world-width + world-height)
  
  repeat dimensione-mappa [
    ask patches with [walkable? = true] [
      ; Ogni patch guarda i suoi 4 vicini a croce e prende il numero più basso + 1
      set dist-cassa min (list dist-cassa (min [dist-cassa] of neighbors4 + 1))
      set dist-drink min (list dist-drink (min [dist-drink] of neighbors4 + 1))
      set dist-birra min (list dist-birra (min [dist-birra] of neighbors4 + 1))
      set dist-giochi min (list dist-giochi (min [dist-giochi] of neighbors4 + 1))
      set dist-bagno min (list dist-bagno (min [dist-bagno] of neighbors4 + 1))
    ]
  ]
end

to rifletti [ evento-attuale ]
  if is-ocean? = true [
    ; Prepara il profilo in formato compatto
    let mio-profilo (word "O:" precision trait-O 1 " C:" precision trait-C 1 " E:" precision trait-E 1 " A:" precision trait-A 1 " N:" precision trait-N 1)
    
    ; --- Passaggio sicuro delle variabili ---
    py:set "profilo_py" mio-profilo
    py:set "memoria_py" memoria
    py:set "evento_py" evento-attuale
    
    ; Interroga Ollama senza incollare le stringhe
    let pensiero py:runresult "genera_pensiero(profilo_py, memoria_py, evento_py)"
    
    ; Stampa nella console includendo i tratti OCEAN
    print (word "Agente " who " [" mio-profilo "] | Evento: " evento-attuale)
    print (word "   -> Pensiero: " pensiero)
    print "--------------------------------------------------"
    
    ; AGGIORNA LA MEMORIA: Aggiungiamo l'ultimo pensiero ai ricordi
    set memoria (word "In precedenza: " evento-attuale ". Ho pensato: " pensiero)
    
    ; Opzionale: mostra un riassunto sulla testa
    set label pensiero
  ]
end]]></code>
